# OS / editor files
.DS_Store
Thumbs.db
.idea/
*.iml

# Android / Gradle
.gradle/
.kotlin/
**/build/
local.properties
.cxx/

# Exported APKs are delivered as workflow artifacts, not committed binaries.
artifacts/
*.apk
*.aab
*.idsig

# Signing keys and local credentials
*.jks
*.keystore
.env
.env.*
!.env.example

# Local debugging artifacts
*.hprof
captures/

# Local/private ROMs are packaged only into explicitly requested personal APKs.
roms/*
!roms/.gitkeep
!roms/README.md

# Private CI inputs downloaded from a private release, never committed.
ci-rom/
